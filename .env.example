# Copy this file to .env, then keep ONE of the options below. Never commit .env.

# Option 1: Claude through the Anthropic API (needs a real key from Claude Console)
ANTHROPIC_API_KEY=your-key-here
AGENT_MODEL=claude-haiku-5-5
AGENT_THINKING=on

# Option 2: a local model through Ollama (free, no real key needed)
# ANTHROPIC_API_KEY=ollama
# ANTHROPIC_BASE_URL=http://localhost:11434
# AGENT_MODEL=qwen3:4b
# AGENT_THINKING=off

# Option 3: Gemini (free tier) through the OpenAI-compatible adapter in providers.py
# MODEL_PROVIDER=openai
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=your-gemini-key-here
# AGENT_MODEL=a-gemini-model-id
